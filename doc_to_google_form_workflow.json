    {
      "parameters": {
        "jsCode": "const TEXTS = {\n  en: {\n    ask_email: 'Enter your email',\n    confirm_email_set: 'Your email is stored for further operations',\n    ask_info: 'Enter the name for new test and attach .docx file',\n    group_field_title: 'Class Name',\n    fullname_field_title: 'Full Name',\n    test_created: 'successfully created',\n    form_link: 'Form',\n    spreadsheet_link: 'Results',\n    error: 'Something went wrong. Try again.',\n  },\n  uk: {\n    ask_email: 'Вкажіть свій Email',\n    confirm_email_set: 'Ваш Email збережно для подальшої роботи',\n    ask_info: 'Вкажіть назву тесту та додйте файл .docx',\n    group_field_title: 'Назва групи',\n    fullname_field_title: 'Повне імʼя (ПІП)',\n    test_created: 'успішно створено',\n    form_link: 'Тест',\n    spreadsheet_link: 'Результати',\n    error: 'Щось пішло не так. Спробуйте знову.',\n  }\n};\n\nconst DEFAULT = 'en';\n\nreturn $input.all().map(item => {\n  const from = item.json.message?.from ?? item.json.callback_query?.from ?? {};\n  const code = (from.language_code ?? '').toLowerCase().split('-')[0]; // pt-br -> pt\n  const lang = TEXTS[code] ? code : DEFAULT;\n  const t = { ...TEXTS[DEFAULT], ...TEXTS[lang] }; // недостающие ключи берутся из en\n\n  // подстановка {name} сразу\n  const name = from.first_name ?? '';\n  for (const k in t) t[k] = t[k].replace('{name}', name);\n\n  return { json: { ...item.json, lang, t } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        80
      ],
